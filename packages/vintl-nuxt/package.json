{
  "name": "@vintl/nuxt",
  "version": "1.9.2",
  "description": "Nuxt Module for VIntl integration",
  "keywords": [
    "i18n",
    "intl",
    "nuxt"
  ],
  "homepage": "https://github.com/vintl-dev/nuxt/tree/main/packages/vintl-nuxt",
  "bugs": "https://github.com/vintl-dev/nuxt/issues",
  "author": {
    "name": "Alexander 'Brawaru' Sorokin",
    "url": "https://github.com/brawaru"
  },
  "funding": "https://github.com/brawaru/brawaru/blob/main/SUPPORT.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/vintl-dev/nuxt.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    },
    "./options": {
      "import": "./dist/options.mjs"
    },
    "./package.json": "./package.json"
  },
  "module": "./dist/module.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "prepack": "pnpm turbo --no-daemon build"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.2",
    "@nuxt/eslint-config": "^1.7.1",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.0.2",
    "@types/babel__generator": "^7.27.0",
    "@types/hash-sum": "^1.0.2",
    "@types/node": "^18.19.64",
    "@vintl-dev/eslint-config-peony": "workspace:^",
    "nuxt": "^4.0.2",
    "typescript": "^5.6.3",
    "vue-tsc": "^3.0.5"
  },
  "dependencies": {
    "@babel/generator": "^7.28.0",
    "@babel/types": "^7.28.2",
    "@formatjs/intl": "^3.1.6",
    "@formatjs/intl-localematcher": "^0.6.1",
    "@nuxt/kit": "^4.0.2",
    "@vintl/unplugin": "workspace:^",
    "@vintl/vintl": "^4.4.1",
    "consola": "^3.4.2",
    "hash-sum": "^2.0.0",
    "import-meta-resolve": "^4.1.0",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "slash": "^5.1.0",
    "ufo": "^1.6.1"
  }
}
